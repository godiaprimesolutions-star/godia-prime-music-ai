# Set these in Netlify UI, not in index.html or GitHub. Do not paste real secrets here.
HF_TOKEN=
# Must be a Hugging Face Inference Endpoint or compatible inference URL that generates audio from JSON input.
# The endpoint request format differs by model; verify the model's documentation first.
HF_MUSIC_ENDPOINT=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# For STK Push, use the shortcode registered for your Daraja product and transaction type.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# For a Buy Goods/Till integration this is commonly CustomerBuyGoodsOnline; confirm your Daraja setup.
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Optional. Defaults to https://<your-site>/.netlify/functions/mpesa-callback
URL=
# Must match your approved business Till/Paybill configuration. This package defaults the customer-facing label to 1692851.
MPESA_DISPLAY_TILL=1692851
